{
  "name": "soliaris-africa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
