# Formspree form endpoint for the Contact page (create a form at https://formspree.io).
# On Vercel, set this under Project Settings → Environment Variables.
VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Public site address (no trailing slash) for canonical links, share tags and the sitemap.
VITE_SITE_URL=https://www.your-domain.com
